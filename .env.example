# Configuración del mostrador (la computadora que imprime tickets).
# No subas el archivo .env real a GitHub.
REMOTE_API_URL=https://tu-servicio.onrender.com
BRIDGE_TOKEN=usa-el-mismo-secreto-que-configures-en-Render
REMOTE_POLLING_MS=6000
TICKET_PRINTER=POS-58 2

# Opcional: deja este valor vacío para que el sistema local siga guardando en data/.
# DATA_DIR=C:\ruta\para\guardar\datos
